#!/usr/bin/env bash
# Toy build: RO-friendly. Writes only under src/build and src/bin.
# Timestamp is in the filename only so artifact sha256 of the content is stable.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
SRC="$HERE/src"
[[ -d "$SRC" ]] || { echo "no src — run: ./fetch-deps ro example" >&2; exit 1; }

mkdir -p "$SRC/build" "$SRC/bin"

VER="0.0.1"
TS=$(date -u +%Y%m%dT%H%M%SZ)
OUT="$SRC/bin/hello-${VER}-${TS}.bin"
echo "hello from third_party/example pin ${VER}" >"$SRC/build/hello.txt"
cp -f "$SRC/build/hello.txt" "$OUT"
cp -f "$OUT" "$SRC/bin/hello-latest.bin"
echo "wrote $OUT"
