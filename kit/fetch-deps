#!/usr/bin/env bash
# fetch-deps — consumer-side pin / rw / upgrade materialize
#
# Defaults:
#   fetch-deps [name…]           # ro pin @ libpin.toml git_sha (patches, then chmod a-w)
#   fetch-deps rw [name…]        # writable branch = work (override --branch)
#   fetch-deps ro [name…]        # back to pin
#   fetch-deps status [-v|-vv]
#   fetch-deps refresh [name…]   # advance pin along track_branch (git only)
#   fetch-deps upgrade NAME --ref REF
#   fetch-deps build [name…]     # run build[] then get-artifacts
#   fetch-deps check [name…]     # host_repo, git_home leak, depends, moved tags
#   fetch-deps outdated [name…]  # compare pins to upstream; record tip in status.local
#
# Pin file: third_party/<name>/libpin.toml
# Transport: declared loud fallback (printed), never a silent swallow.
#   usable host shortcut, else git_https if set, else git_ssh if set, else
#   source_kind=seed-src. A failed git_https fetch does not retry git_ssh.
#   Host is never mandatory when a remote URL is set. Permission/SSH failures
#   print the exact command the owner can run (chmod/setfacl/ssh); the agent
#   then uses the remote URL when present. Ambiguous sha on a readable host
#   is a hard fail (do not network for a different commit).
# Pins with default = false are omitted from the default NAME set.
#
# git_home= is smudged by consumers (lowercase LHS). --git-home DIR overrides.
# A leftover @@…@@ token is always an error. Unset GIT_HOME skips the host
# shortcut and uses the remote URL.
# GIT_TERMINAL_PROMPT=0 so an agent never hangs on a credential prompt.
#
# Sandbox: bwrap + Landlock via libpin-sandbox, used when available
#   (see docs/SANDBOX.md). --no-* disables one; --require-* stops if missing.
LIBPIN_VERSION=2026.10.24
set -euo pipefail
if [[ -z "${LIBPIN_INSIDE:-}" ]]; then
  LIBPIN_INVOCATION=$(printf '%q ' "$0" "$@")
  LIBPIN_INVOCATION="${LIBPIN_INVOCATION% }"
  export LIBPIN_INVOCATION
fi
export GIT_TERMINAL_PROMPT=0

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$ROOT/.." && pwd)"
CMD=""
NO_BWRAP=0
NO_LANDLOCK=0
REQUIRE_BWRAP=0
REQUIRE_LANDLOCK=0
BASE_REF=""
BRANCH_OVERRIDE=""
REF_UPGRADE=""
RECORD=0
VERBOSE=0
NAMES=()
FAILED_NAMES=()
PRINT_ARGS=()
# Smudged LHS must be lowercase git_home= so a consumer clean filter can restore the path.
# Do not hard-code a machine path. --git-home overrides.
git_home=

usage() {
  cat <<'EOF'
Usage:
  third_party/fetch-deps [options] [NAME…]
  third_party/fetch-deps <command> [options] [NAME…]

Commands:
  (default)   Read-only pin (git @ git_sha and/or [[source]] files; then RO)
  ro          Same as default; force back to pin
  rw          Writable branch (git pins: work @ pin sha). File pins: writable src
  status      Show mode / HEAD / pin / dirty (-v / -vv)
  refresh     Advance pin SHA along track_branch + materialize ro (git only)
  upgrade     NAME --ref REF  try ref, build, collect artifacts, update libpin.toml
              (git_sha, git_describe and every changed [[artifact]] sha256; a pin with
              reproducible = true is built a second time and must give the same bytes)
  build       Run build[] from libpin.toml, then get-artifacts (artifacts must match sha256)
  check       Validate host_repo, git_home leak, depends, moved tags
  outdated    Compare each pin to upstream; store the tip in status.local

Options:
  --git-home DIR       Override smudged git_home
  --branch NAME        rw/upgrade branch name (defaults: work / upgrade/<ref>)
  --base REF           rw base (default: pin git_sha)
  --ref REF            upgrade source ref
  --record             build: write the new [[artifact]] sha256 values into libpin.toml
  --no-bwrap           Disable bubblewrap (or LIBPIN_NO_BWRAP=1)
  --no-landlock        Disable Landlock (or LIBPIN_NO_LANDLOCK=1)
  --require-bwrap      Stop if bubblewrap is not available
  --require-landlock   Stop if Landlock is not available
  --require-libpin     Same as --require-landlock
  -v, -vv              status verbosity
  -h, --help

libpin.toml = pin contract only (no checkout mode). Mode is status.local (gitignored).

Non-git pins ([[source]] tables):
  url      https://… | http://… | file:relative | file:///abs  (no git@ / ssh)
  seed     path under third_party/<lib>/ (copy; same as file: seed)
  path     destination under third_party/<lib>/src/
  sha256   required content hash (hex)

Sandbox (used when available; see docs/SANDBOX.md):
  materialize + status.local  write → third_party/<lib>/  (mode=lib)
  patches                     write → third_party/<lib>/src/ only
  build steps                 write → third_party/<lib>/src/ only
  get-artifacts               no sandbox (destinations may be app/… under the repo root)
EOF
}

die() {
  echo "fetch-deps: $*" >&2
  exit 1
}

check_kit_version() {
  local vfile="$ROOT/VERSION" v
  [[ -f "$vfile" ]] || die "missing $vfile (companion VERSION stamp)"
  v="$(tr -d '[:space:]' <"$vfile")"
  [[ "$v" == "$LIBPIN_VERSION" ]] || die "VERSION mismatch: kit/VERSION=$v embedded=$LIBPIN_VERSION"
}

check_kit_version

# --- parse ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    ro|rw|status|refresh|upgrade|build|check|outdated)
      if [[ -z "$CMD" ]]; then CMD="$1"; shift; else NAMES+=("$1"); shift; fi ;;
    --no-bwrap) NO_BWRAP=1; shift ;;
    --no-landlock) NO_LANDLOCK=1; shift ;;
    --require-bwrap) REQUIRE_BWRAP=1; shift ;;
    --require-landlock|--require-libpin) REQUIRE_LANDLOCK=1; shift ;;
    --git-home) git_home="$2"; shift 2 ;;
    --branch) BRANCH_OVERRIDE="$2"; shift 2 ;;
    --base) BASE_REF="$2"; shift 2 ;;
    --ref) REF_UPGRADE="$2"; shift 2 ;;
    --record) RECORD=1; shift ;;
    --print-host-perm-suggestions)
      CMD=print-host-perm-suggestions
      shift
      PRINT_ARGS=()
      n=0
      while [[ $n -lt 8 && $# -gt 0 ]]; do
        PRINT_ARGS+=("$1")
        shift
        n=$((n + 1))
      done
      if [[ $n -ne 8 ]]; then
        echo "fetch-deps: --print-host-perm-suggestions needs 8 arguments" >&2
        exit 2
      fi
      ;;
    --print-owner-host-perm)
      CMD=print-owner-host-perm
      shift
      PRINT_ARGS=()
      n=0
      while [[ $n -lt 3 && $# -gt 0 ]]; do
        PRINT_ARGS+=("$1")
        shift
        n=$((n + 1))
      done
      if [[ $n -ne 3 ]]; then
        echo "fetch-deps: --print-owner-host-perm needs 3 arguments" >&2
        exit 2
      fi
      ;;
    -vv) VERBOSE=2; shift ;;
    -v) VERBOSE=1; shift ;;
    --) shift; break ;;
    -*)
      echo "fetch-deps: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *) NAMES+=("$1"); shift ;;
  esac
done
while [[ $# -gt 0 ]]; do NAMES+=("$1"); shift; done

CMD="${CMD:-ro}"

GIT_HOME="${git_home:-}"

if [[ -n "$GIT_HOME" && "$GIT_HOME" == *"@@"* ]]; then
  die "leftover smudge token in git_home ($GIT_HOME)"
fi

if [[ "$REQUIRE_BWRAP" -eq 1 && "$NO_BWRAP" -eq 1 ]]; then
  echo "fetch-deps: --require-bwrap conflicts with --no-bwrap" >&2
  exit 2
fi
if [[ "$REQUIRE_LANDLOCK" -eq 1 && "$NO_LANDLOCK" -eq 1 ]]; then
  echo "fetch-deps: --require-landlock conflicts with --no-landlock" >&2
  exit 2
fi
if [[ "$REQUIRE_BWRAP" -eq 1 && "${LIBPIN_NO_BWRAP:-0}" == "1" ]]; then
  echo "fetch-deps: --require-bwrap conflicts with LIBPIN_NO_BWRAP=1" >&2
  exit 2
fi
if [[ "$REQUIRE_LANDLOCK" -eq 1 && "${LIBPIN_NO_LANDLOCK:-0}" == "1" ]]; then
  echo "fetch-deps: --require-landlock conflicts with LIBPIN_NO_LANDLOCK=1" >&2
  exit 2
fi

BWRAP_STATE=available
BWRAP_REASON=""
LANDLOCK_STATE=available
LANDLOCK_REASON=""

if [[ "$NO_BWRAP" -eq 1 ]]; then
  BWRAP_STATE=disabled
  BWRAP_REASON="--no-bwrap"
elif [[ "${LIBPIN_NO_BWRAP:-0}" == "1" ]]; then
  NO_BWRAP=1
  BWRAP_STATE=disabled
  BWRAP_REASON="LIBPIN_NO_BWRAP=1"
else
  if ! command -v bwrap >/dev/null; then
    BWRAP_STATE=unavailable
    BWRAP_REASON="bwrap not found on PATH"
  elif [[ ! -x "$ROOT/libpin-bwrap" ]]; then
    BWRAP_STATE=unavailable
    BWRAP_REASON="libpin-bwrap not executable"
  else
    bwrap_rc=0
    bwrap_err="$(bwrap --ro-bind / / true 2>&1)" || bwrap_rc=$?
    if [[ "$bwrap_rc" -ne 0 ]]; then
      BWRAP_STATE=unavailable
      bwrap_err="$(printf '%s' "$bwrap_err" | tr '\n' ' ')"
      bwrap_err="${bwrap_err%" "}"
      if [[ -n "$bwrap_err" ]]; then
        BWRAP_REASON="$bwrap_err"
      else
        BWRAP_REASON="bwrap --ro-bind / / true exited $bwrap_rc"
      fi
    fi
  fi
fi

if [[ "$NO_LANDLOCK" -eq 1 ]]; then
  LANDLOCK_STATE=disabled
  LANDLOCK_REASON="--no-landlock"
elif [[ "${LIBPIN_NO_LANDLOCK:-0}" == "1" ]]; then
  NO_LANDLOCK=1
  LANDLOCK_STATE=disabled
  LANDLOCK_REASON="LIBPIN_NO_LANDLOCK=1"
else
  if [[ ! -x "$ROOT/libpin-landlock" ]]; then
    LANDLOCK_STATE=unavailable
    LANDLOCK_REASON="libpin-landlock not executable"
  else
    ll_rc=0
    ll_out="$("$ROOT/libpin-landlock" --status 2>&1)" || ll_rc=$?
    if [[ "$ll_rc" -ne 0 ]]; then
      LANDLOCK_STATE=unavailable
      ll_out="$(printf '%s' "$ll_out" | tr '\n' ' ')"
      ll_out="${ll_out%" "}"
      if [[ -n "$ll_out" ]]; then
        LANDLOCK_REASON="$ll_out"
      else
        LANDLOCK_REASON="libpin-landlock --status exited $ll_rc"
      fi
    else
      LANDLOCK_REASON="${ll_out#available }"
      LANDLOCK_REASON="${LANDLOCK_REASON/=/ }"
    fi
  fi
fi

if [[ "$REQUIRE_BWRAP" -eq 1 && "$BWRAP_STATE" != "available" ]]; then
  die "bwrap required (--require-bwrap) but unavailable ($BWRAP_REASON)"
fi
if [[ "$REQUIRE_LANDLOCK" -eq 1 && "$LANDLOCK_STATE" != "available" ]]; then
  die "Landlock required (--require-landlock) but unavailable ($LANDLOCK_REASON)"
fi

if [[ -z "${LIBPIN_INSIDE:-}" ]]; then
  case "$BWRAP_STATE" in
    disabled) echo "libpin: sandbox: bwrap disabled ($BWRAP_REASON)" >&2 ;;
    unavailable) echo "libpin: sandbox: bwrap unavailable ($BWRAP_REASON); continuing without it" >&2 ;;
    available) echo "libpin: sandbox: bwrap available; write confinement on" >&2 ;;
  esac
  case "$LANDLOCK_STATE" in
    disabled) echo "libpin: sandbox: Landlock disabled ($LANDLOCK_REASON)" >&2 ;;
    unavailable) echo "libpin: sandbox: Landlock unavailable ($LANDLOCK_REASON); continuing without it" >&2 ;;
    available) echo "libpin: sandbox: Landlock available ($LANDLOCK_REASON); write confinement on" >&2 ;;
  esac
  if [[ "$BWRAP_STATE" != "available" && "$LANDLOCK_STATE" != "available" ]]; then
    echo "libpin: sandbox: none active; pin writes are not confined" >&2
  fi
fi

if [[ "$BWRAP_STATE" != "available" ]]; then
  NO_BWRAP=1
fi
if [[ "$LANDLOCK_STATE" != "available" ]]; then
  NO_LANDLOCK=1
fi
if [[ "$NO_BWRAP" -eq 1 ]]; then
  export LIBPIN_NO_BWRAP=1
fi
if [[ "$NO_LANDLOCK" -eq 1 ]]; then
  export LIBPIN_NO_LANDLOCK=1
fi
export GIT_HOME

sandbox_run() {
  local mode="$1" name="$2"
  shift 2
  [[ -x "$ROOT/libpin-sandbox" ]] || die "libpin-sandbox not executable"
  "$ROOT/libpin-sandbox" --mode "$mode" --lib "$name" -- "$@"
}

ENV_BIN=/usr/bin/env
[[ -x "$ENV_BIN" ]] || die "$ENV_BIN not found (needed for sandbox re-entry)"

reenter_self() {
  local mode="$1" name="$2" cmd="$3"
  local args=()
  [[ -n "${GIT_HOME:-}" ]] && args+=(--git-home "$GIT_HOME")
  [[ -n "$BRANCH_OVERRIDE" ]] && args+=(--branch "$BRANCH_OVERRIDE")
  [[ -n "$BASE_REF" ]] && args+=(--base "$BASE_REF")
  [[ -n "$REF_UPGRADE" ]] && args+=(--ref "$REF_UPGRADE")
  [[ "$RECORD" -eq 1 ]] && args+=(--record)
  [[ "$VERBOSE" -ge 2 ]] && args+=(-vv)
  [[ "$VERBOSE" -eq 1 ]] && args+=(-v)
  # Already inside bwrap: do not nest. Landlock stacks for src/artifact holes
  # unless the caller asked for --no-landlock.
  args+=(--no-bwrap)
  [[ "$NO_LANDLOCK" -eq 1 ]] && args+=(--no-landlock)
  sandbox_run "$mode" "$name" "$ENV_BIN" LIBPIN_INSIDE=1 \
    "$ROOT/fetch-deps" "${args[@]}" "$cmd" "$name"
}

should_reenter() {
  [[ -z "${LIBPIN_INSIDE:-}" && ( "$NO_BWRAP" -eq 0 || "$NO_LANDLOCK" -eq 0 ) ]]
}

bwrap_src() {
  local name="$1"; shift
  sandbox_run src "$name" "$@"
}

pin_path() { echo "$ROOT/$1/libpin.toml"; }
src_path() { echo "$ROOT/$1/src"; }
status_path() { echo "$ROOT/$1/status.local"; }

pin_get() {
  local file="$1" key="$2"
  [[ -r "$file" ]] || return 1
  if [[ "$file" == *.toml ]]; then
    python3 - "$file" "$key" <<'PY'
import sys
import tomllib
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
key = sys.argv[2]
if key not in data:
    sys.exit(3)
v = data[key]
if isinstance(v, bool):
    print("true" if v else "false")
elif isinstance(v, list):
    print("\n".join(str(x) for x in v))
else:
    print(v)
PY
  else
    sed -n "s/^${key}:[[:space:]]*//p" "$file" | head -1 | sed 's/^["'\'']//;s/["'\'']$//'
  fi
}

pin_get_opt() {
  local file="$1" key="$2" out rc=0
  [[ "$file" == *.toml ]] || { echo "fetch-deps: pin_get_opt needs a .toml pin, got $file" >&2; return 2; }
  [[ -r "$file" ]] || { echo "fetch-deps: cannot read $file" >&2; return 2; }
  out="$(pin_get "$file" "$key")" && { printf '%s\n' "$out"; return 0; }
  rc=$?
  [[ "$rc" -eq 3 ]] && return 0
  echo "fetch-deps: reading $key from $file failed (exit $rc)" >&2
  return "$rc"
}

pin_has_key() {
  local file="$1" key="$2" rc=0
  pin_get "$file" "$key" >/dev/null || rc=$?
  [[ "$rc" -eq 0 ]] && return 0
  [[ "$rc" -eq 3 ]] && return 1
  echo "fetch-deps: reading $key from $file failed (exit $rc)" >&2
  return 2
}

pin_build_steps() {
  local file="$1"
  python3 - "$file" <<'PY'
import sys
import tomllib
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
if "build" not in data:
    steps = ["./build"]
else:
    steps = data.get("build")
    if steps is None:
        steps = []
    elif isinstance(steps, str):
        steps = [steps]
for s in steps or []:
    if s:
        print(s)
PY
}

is_real_sha() {
  local s="${1:-}"
  [[ -n "$s" && "$s" != "TBD" && "$s" != "null" && "$s" =~ ^[0-9a-fA-F]{4,40}$ ]]
}

git_host() {
  local host="$1"
  shift
  [[ "$host" == /* ]] || die "git_host: host path must be absolute: $host"
  git -c "safe.directory=$host" -C "$host" "$@"
}

# host_repo key is "set" only when present in TOML. Prints the value; rc 1 = absent, 2 = error.
host_repo_set() {
  local file out rc=0
  file="$(pin_path "$1")"
  out="$(pin_get "$file" host_repo)" && { printf '%s' "$out"; return 0; }
  rc=$?
  [[ "$rc" -eq 3 ]] && return 1
  return 2
}

# Resolve host shortcut: rc 0 = path printed, 1 = no usable host (use remote),
# 2 = pin config error (smudge / empty / absolute-under-GIT_HOME).
local_repo_for() {
  local name="$1" hrset=0 hr="" p gh_real hr_real
  if hr="$(host_repo_set "$name")"; then
    hrset=1
  else
    local rc=$?
    [[ "$rc" -eq 1 ]] || return 2
  fi

  if [[ "$hrset" -eq 1 ]]; then
    [[ -n "$hr" ]] || { echo "fetch-deps: FAIL $name: host_repo is empty" >&2; return 2; }
    if [[ "$hr" == *"@@"* ]]; then
      echo "fetch-deps: FAIL $name: leftover smudge token in host_repo ($hr)" >&2
      return 2
    fi
    if [[ "$hr" == /* ]]; then
      if [[ -n "${GIT_HOME:-}" ]]; then
        gh_real="$(realpath -m "$GIT_HOME")"
        hr_real="$(realpath -m "$hr")"
        case "$hr_real" in
          "$gh_real"|"$gh_real"/*)
            echo "fetch-deps: FAIL $name: absolute host_repo $hr is under GIT_HOME ($GIT_HOME); use the name" >&2
            return 2
            ;;
        esac
      fi
      host_shortcut_from_path "$name" "$hr"
      return $?
    fi
    if [[ -z "${GIT_HOME:-}" ]]; then
      return 1
    fi
    host_shortcut_from_path "$name" "$GIT_HOME/$hr"
    return $?
  fi

  if [[ -z "${GIT_HOME:-}" ]]; then
    return 1
  fi
  p="$GIT_HOME/$name"
  if [[ -e "$p" ]]; then
    host_shortcut_from_path "$name" "$p"
    return $?
  fi
  return 1
}

abs_host_path() {
  local p="$1"
  [[ "$p" == /* ]] || p="$PWD/$p"
  printf '%s' "$p"
}

print_rerun_line() {
  if [[ -n "${LIBPIN_INVOCATION:-}" ]]; then
    echo "  then: $LIBPIN_INVOCATION" >&2
  else
    echo "  then: original command could not be determined" >&2
  fi
}

# Read gitdir: from a gitfile. rc 1 = no gitdir: line.
read_gitdir_file() {
  local gitfile="$1" line rel dir rc=0 resolved
  dir="$(dirname "$gitfile")"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    case "$line" in
      gitdir:*)
        rel="${line#gitdir:}"
        rel="${rel#"${rel%%[![:space:]]*}"}"
        rel="${rel%"${rel##*[![:space:]]}"}"
        [[ -n "$rel" ]] || return 1
        if [[ "$rel" == /* ]]; then
          printf '%s\n' "$rel"
          return 0
        fi
        resolved="$(realpath -m "$dir/$rel" 2>&1)" || rc=$?
        if [[ "$rc" -ne 0 ]]; then
          echo "NOSTAT $dir/$rel $resolved"
          return 2
        fi
        printf '%s\n' "$resolved"
        return 0
        ;;
    esac
  done < "$gitfile"
  return 1
}

# Walk components of an absolute path. Prints BLOCKED/MISSING/NOSTAT on failure.
# Leaf is kind file if it is a file, else repo; strict prefixes are ancestor.
walk_path_components() {
  local target="$1" accum="" rest part kind st rc
  rest="${target#/}"
  while [[ -n "$rest" ]]; do
    part="${rest%%/*}"
    if [[ "$rest" == */* ]]; then
      rest="${rest#*/}"
    else
      rest=""
    fi
    [[ -n "$part" ]] || continue
    accum="$accum/$part"
    if [[ ! -e "$accum" ]]; then
      echo "MISSING $accum"
      return 1
    fi
    rc=0
    st="$(stat -c '%U %G %a' "$accum" 2>&1)" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
      echo "NOSTAT $accum $st"
      return 1
    fi
    if [[ "$accum" == "$target" ]]; then
      if [[ -f "$accum" ]]; then
        kind=file
      else
        kind=repo
      fi
    else
      kind=ancestor
    fi
    case "$kind" in
      ancestor)
        if [[ ! -x "$accum" ]]; then
          echo "BLOCKED $kind $accum $st"
          return 1
        fi
        ;;
      repo)
        if [[ ! -r "$accum" || ! -x "$accum" ]]; then
          echo "BLOCKED $kind $accum $st"
          return 1
        fi
        ;;
      file)
        if [[ ! -r "$accum" ]]; then
          echo "BLOCKED $kind $accum $st"
          return 1
        fi
        ;;
    esac
  done
  return 0
}

# Prints one of: OK | BLOCKED kind path owner group mode | MISSING path
# | NOSTAT path err | NOTGIT no.git | NOTGIT nogitdir
inspect_host_path() {
  local checkout gitdir rc=0 gd_rc=0 st
  checkout="$(abs_host_path "$1")"
  walk_path_components "$checkout" || return 1
  if [[ ! -e "$checkout/.git" ]]; then
    echo "NOTGIT no.git"
    return 1
  fi
  if [[ -f "$checkout/.git" ]]; then
    if [[ ! -r "$checkout/.git" ]]; then
      rc=0
      st="$(stat -c '%U %G %a' "$checkout/.git" 2>&1)" || rc=$?
      if [[ "$rc" -ne 0 ]]; then
        echo "NOSTAT $checkout/.git $st"
        return 1
      fi
      echo "BLOCKED file $checkout/.git $st"
      return 1
    fi
    gitdir="$(read_gitdir_file "$checkout/.git")" || gd_rc=$?
    if [[ "$gd_rc" -eq 2 ]]; then
      printf '%s\n' "$gitdir"
      return 1
    fi
    if [[ "$gd_rc" -ne 0 ]]; then
      echo "NOTGIT nogitdir"
      return 1
    fi
  else
    gitdir="$checkout/.git"
  fi
  walk_path_components "$gitdir" || return 1
  echo OK
  return 0
}

# rc 0 = usable git repo on stdout; 1 = skip shortcut (message already printed).
host_shortcut_from_path() {
  local name="$1" p="$2" result rc=0 err
  p="$(abs_host_path "$p")"
  result="$(inspect_host_path "$p")" || rc=$?
  case "$result" in
    OK) ;;
    BLOCKED\ *)
      report_owner_host_perm "$p" "$name" ""
      return 1
      ;;
    MISSING\ *)
      echo "fetch-deps: host shortcut $p does not exist (offline shortcut skipped)" >&2
      return 1
      ;;
    NOSTAT\ *)
      echo "fetch-deps: could not determine owner/group/mode (${result#NOSTAT })" >&2
      return 1
      ;;
    "NOTGIT no.git")
      echo "fetch-deps: host shortcut $p exists but is not a git repo (no .git)" >&2
      return 1
      ;;
    "NOTGIT nogitdir")
      echo "fetch-deps: host shortcut $p exists but is not a git repo ('.git' file has no gitdir: line)" >&2
      return 1
      ;;
    *)
      echo "fetch-deps: host shortcut $p inspect failed ($result)" >&2
      return 1
      ;;
  esac
  err="$(git -c "safe.directory=$p" -C "$p" rev-parse --git-dir 2>&1)" || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    realpath "$p"
    return 0
  fi
  if [[ "$err" == *"Permission denied"* || "$err" == *"dubious ownership"* ]]; then
    echo "fetch-deps: git -C $p rev-parse --git-dir failed: $err" >&2
    report_owner_host_perm "$p" "$name" "$err"
    return 1
  fi
  echo "fetch-deps: host shortcut $p exists but is not a git repo (git: $err); skipping it" >&2
  return 1
}

# Pure: prints suggestion commands only. groups is one space-separated argument.
host_perm_suggestions() {
  local path="$1" kind="$2" owner="$3" group="$4" mode="$5" agent="$6" groups="$7" setfacl_ok="$8"
  local oct gbits has_r=0 has_x=0 need_r=0 need_x=0 in_group=0 group_ok=1 g
  oct="$mode"
  while [[ ${#oct} -gt 3 ]]; do
    oct="${oct:1}"
  done
  while [[ ${#oct} -lt 3 ]]; do
    oct="0$oct"
  done
  gbits="${oct:1:1}"
  [[ $((gbits & 4)) -ne 0 ]] && has_r=1
  [[ $((gbits & 1)) -ne 0 ]] && has_x=1
  case "$kind" in
    ancestor) need_x=1 ;;
    repo) need_r=1; need_x=1 ;;
    file) need_r=1 ;;
  esac
  for g in $groups; do
    [[ "$g" == "$group" ]] && in_group=1
  done
  [[ "$need_r" -eq 1 && "$has_r" -eq 0 ]] && group_ok=0
  [[ "$need_x" -eq 1 && "$has_x" -eq 0 ]] && group_ok=0

  if [[ "$group_ok" -eq 1 && "$in_group" -eq 0 ]]; then
    echo "sudo usermod -aG $group $agent"
    echo "new login or \`newgrp $group\`; restart the agent session"
  elif [[ "$group_ok" -eq 0 ]]; then
    case "$kind" in
      ancestor) echo "chmod g+x $path" ;;
      repo) echo "chmod -R g+rX $path" ;;
      file) echo "chmod g+r $path" ;;
    esac
    if [[ "$in_group" -eq 0 ]]; then
      echo "sudo usermod -aG $group $agent"
      echo "new login or \`newgrp $group\`; restart the agent session"
    fi
  fi

  if [[ "$setfacl_ok" == "1" ]]; then
    case "$kind" in
      ancestor) echo "setfacl -m u:${agent}:x $path" ;;
      repo)
        echo "setfacl -R -m u:${agent}:rX $path"
        echo "setfacl -R -d -m u:${agent}:rX $path"
        ;;
      file) echo "setfacl -m u:${agent}:r $path" ;;
    esac
  else
    echo "setfacl is not installed"
  fi

  echo "broad (every user)"
  case "$kind" in
    ancestor) echo "chmod a+x $path" ;;
    repo) echo "chmod -R a+rX $path" ;;
    file) echo "chmod a+r $path" ;;
  esac
}

report_owner_host_perm() {
  local host="$1" name="$2" git_stderr="${3:-}"
  local agent groups setfacl_ok=0 result rc=0 blocked=0 kind bpath owner group mode st
  agent="$(id -un)"
  groups="$(id -Gn)"
  if command -v setfacl >/dev/null; then
    setfacl_ok=1
  fi
  echo "fetch-deps: host shortcut $host is not readable (you are $agent)" >&2
  echo "  Host is an optional offline shortcut. A git_https or git_ssh URL will be used when set." >&2

  result="$(inspect_host_path "$host")" || rc=$?
  case "$result" in
    BLOCKED\ *)
      blocked=1
      # BLOCKED kind path owner group mode  — path may contain spaces; kind is one token.
      kind="${result#BLOCKED }"
      kind="${kind%% *}"
      st="${result#BLOCKED $kind }"
      mode="${st##* }"
      st="${st% $mode}"
      group="${st##* }"
      st="${st% $group}"
      owner="${st##* }"
      bpath="${st% $owner}"
      echo "  blocking component: $bpath (kind $kind) owner=$owner group=$group mode=$mode" >&2
      echo "  owner ($owner):" >&2
      host_perm_suggestions "$bpath" "$kind" "$owner" "$group" "$mode" "$agent" "$groups" "$setfacl_ok" | sed 's/^/  /' >&2
      ;;
    NOSTAT\ *)
      echo "  could not determine owner/group/mode (${result#NOSTAT })" >&2
      ;;
  esac

  if [[ "$git_stderr" == *"dubious ownership"* ]]; then
    if [[ "$blocked" -eq 0 ]]; then
      echo "  path is readable by $agent; git reported dubious ownership; -c safe.directory=$host is already passed" >&2
    else
      echo "  fetch-deps already passes -c safe.directory=$host per call; do not edit global git config" >&2
    fi
    echo "  $git_stderr" >&2
  fi
  print_rerun_line
}

is_ssh_url() {
  local u="${1:-}"
  [[ "$u" == git@*:* || "$u" == ssh://* ]]
}

# Sets SSH_USER SSH_HOST SSH_PORT from a git ssh URL.
parse_ssh_url() {
  local u="$1" auth
  SSH_USER=""
  SSH_HOST=""
  SSH_PORT=""
  if [[ "$u" == ssh://* ]]; then
    u="${u#ssh://}"
    auth="${u%%/*}"
    if [[ "$auth" == *@* ]]; then
      SSH_USER="${auth%%@*}"
      auth="${auth#*@}"
    fi
    if [[ "$auth" == *:* && "${auth##*:}" =~ ^[0-9]+$ ]]; then
      SSH_PORT="${auth##*:}"
      SSH_HOST="${auth%:*}"
    else
      SSH_HOST="$auth"
    fi
  elif [[ "$u" == *@*:* ]]; then
    SSH_USER="${u%%@*}"
    auth="${u#*@}"
    SSH_HOST="${auth%%:*}"
  fi
}

ssh_key_name() {
  if [[ -n "$SSH_PORT" ]]; then
    printf '[%s]:%s' "$SSH_HOST" "$SSH_PORT"
  else
    printf '%s' "$SSH_HOST"
  fi
}

report_owner_ssh() {
  local url="$1" dest="$2" err="$3" who keyname rc=0 out target
  who="$(id -un)"
  parse_ssh_url "$url"
  echo "fetch-deps: ssh to $url failed (you are $who)" >&2
  [[ -n "$err" ]] && echo "  $err" >&2
  if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
    echo "  SSH_AUTH_SOCK is unset" >&2
  elif [[ -S "$SSH_AUTH_SOCK" ]]; then
    echo "  SSH_AUTH_SOCK is set to $SSH_AUTH_SOCK and is a socket" >&2
  else
    echo "  SSH_AUTH_SOCK is set to $SSH_AUTH_SOCK but missing (e.g. hidden by sandbox tmpfs /tmp)" >&2
  fi
  if [[ -z "$SSH_USER" && "$url" == ssh://* ]]; then
    echo "  ssh:// URL has no user; ssh will use $who" >&2
  fi
  target=""
  if [[ -n "$SSH_USER" && -n "$SSH_HOST" ]]; then
    target="${SSH_USER}@${SSH_HOST}"
  elif [[ -n "$SSH_HOST" ]]; then
    target="$SSH_HOST"
  fi
  if [[ -n "$target" && -n "$SSH_PORT" ]]; then
    echo "  ssh -T -p $SSH_PORT $target" >&2
  elif [[ -n "$target" ]]; then
    echo "  ssh -T $target" >&2
  fi
  if [[ -n "$dest" ]]; then
    echo "  git clone $url $dest" >&2
  else
    echo "  git clone $url" >&2
  fi
  print_rerun_line

  keyname="$(ssh_key_name)"
  if [[ "$err" == *"REMOTE HOST IDENTIFICATION HAS CHANGED"* ]]; then
    echo "  ssh-keygen -R $keyname" >&2
    echo "  ssh-keyscan -H $SSH_HOST >> ~/.ssh/known_hosts" >&2
    echo "  host key changed, verify fingerprint before trusting" >&2
  elif [[ "$err" == *"Host key verification failed"* || "$err" == *"host key is known"* ]]; then
    echo "  this account (${who})'s known_hosts" >&2
    rc=0
    out="$(ssh-keygen -F "$keyname" 2>&1)" || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      echo "  host key found in known_hosts" >&2
    elif [[ "$rc" -eq 1 ]]; then
      echo "  host key not found in known_hosts" >&2
      echo "  ssh-keyscan -H $SSH_HOST >> ~/.ssh/known_hosts" >&2
      echo "  verify the fingerprint first" >&2
    else
      echo "  ssh-keygen -F $keyname failed (exit $rc): $out" >&2
    fi
  fi
}

# Agents must not hang on a passphrase / host-key prompt. Override GIT_SSH_COMMAND if needed.
prepare_ssh_transport() {
  export GIT_TERMINAL_PROMPT=0
  if [[ -z "${GIT_SSH_COMMAND:-}" && -z "${GIT_SSH:-}" ]]; then
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10"
  fi
}

# Prefer git_https (agents); git_ssh if that is the only remote. rc 1 = none.
pin_remote_url() {
  local lock https ssh
  lock="$(pin_path "$1")"
  https="$(pin_get_opt "$lock" git_https)" || exit 1
  ssh="$(pin_get_opt "$lock" git_ssh)" || exit 1
  [[ "$https" == "null" ]] && https=""
  [[ "$ssh" == "null" ]] && ssh=""
  if [[ -n "$https" ]]; then
    printf '%s\n' "$https"
    return 0
  fi
  if [[ -n "$ssh" ]]; then
    printf '%s\n' "$ssh"
    return 0
  fi
  return 1
}

repo_has_commit() {
  local repo="$1" sha="$2" how="$3" err rc=0
  if [[ "$how" == host ]]; then
    err="$(git_host "$repo" cat-file -e "${sha}^{commit}" 2>&1)" || rc=$?
  else
    err="$(git -C "$repo" cat-file -e "${sha}^{commit}" 2>&1)" || rc=$?
  fi
  [[ "$rc" -eq 0 ]] && return 0
  if [[ "$err" == *"dubious ownership"* || "$err" == *"Permission denied"* ]]; then
    echo "fetch-deps: $err" >&2
    return 2
  fi
  return 1
}

resolve_commit() {
  local repo="$1" ref="$2" how="$3" out rc=0
  if [[ "$how" == host ]]; then
    out="$(git_host "$repo" rev-parse --verify "${ref}^{commit}" 2>&1)" || rc=$?
  else
    out="$(git -C "$repo" rev-parse --verify "${ref}^{commit}" 2>&1)" || rc=$?
  fi
  if [[ "$rc" -ne 0 ]]; then
    echo "fetch-deps: cannot resolve '$ref' in $repo: $out" >&2
    if [[ "$out" == *"ambiguous"* ]]; then
      echo "fetch-deps: sha '$ref' is ambiguous in $repo" >&2
    fi
    return 1
  fi
  printf '%s\n' "$out"
}

is_linked_worktree() {
  [[ -f "${1:-}/.git" ]]
}

is_standalone_clone() {
  local src="$1" top gitdir
  [[ -d "$src/.git" ]] || return 1
  top="$(git -C "$src" rev-parse --show-toplevel)"
  [[ "$(realpath "$top")" == "$(realpath "$src")" ]] || return 1
  gitdir="$(git -C "$src" rev-parse --git-dir)"
  [[ -e "$gitdir/objects/info/alternates" ]] && return 1
  return 0
}

assert_src_toplevel() {
  local src="$1" top src_abs
  [[ -d "$src/.git" || -f "$src/.git" ]] || {
    echo "fetch-deps: $src is not a git checkout; refusing to record sha" >&2
    return 1
  }
  src_abs="$(realpath -s "$src")"
  top="$(git -C "$src" rev-parse --show-toplevel)"
  [[ "$src_abs" == "$top" ]] || {
    echo "fetch-deps: show-toplevel $top != src $src_abs (refusing to pin consumer HEAD)" >&2
    return 1
  }
}

write_status() {
  local name="$1" mode="$2" branch="${3:-}" head="${4:-}" extra="${5:-}"
  local sp
  sp="$(status_path "$name")"
  cat >"$sp" <<EOF
# gitignored — written by fetch-deps; not the pin contract
name: $name
mode: $mode
branch: $branch
head: $head
git_home: $GIT_HOME
updated: $(date -Is)
$extra
EOF
}

status_get() {
  local sp="$1" key="$2"
  [[ -f "$sp" ]] || return 1
  sed -n "s/^${key}:[[:space:]]*//p" "$sp" | head -1
}

ensure_writable_tree() {
  local src="$1"
  [[ -d "$src" ]] || return 0
  chmod -R u+w -- "$src" || { echo "fetch-deps: chmod -R u+w $src failed (you are $(id -un))" >&2; exit 1; }
}

make_readonly_tree() {
  local src="$1"
  [[ -d "$src" ]] || return 0
  local rc=0
  if [[ -d "$src/.git" ]]; then
    find "$src" -path "$src/.git" -prune -o -type f -exec chmod a-w {} + || rc=1
    find "$src" -path "$src/.git" -prune -o -type d -exec chmod u+rwx,go+rx {} + || rc=1
  elif [[ -f "$src/.git" ]]; then
    find "$src" -type f ! -name .git -exec chmod a-w {} + || rc=1
  else
    find "$src" -type f -exec chmod a-w {} + || rc=1
    find "$src" -type d -exec chmod u+rwx,go+rx {} + || rc=1
  fi
  [[ "$rc" -eq 0 ]] || { echo "fetch-deps: making $src read-only failed (you are $(id -un))" >&2; exit 1; }
}

# RO pin: sources a-w; build/ and bin/ stay writable so rebuilds can iterate.
finish_ro_tree() {
  local src="$1" scratch
  make_readonly_tree "$src"
  for scratch in "$src/build" "$src/bin"; do
    [[ -e "$scratch" ]] || continue
    chmod -R u+w -- "$scratch" || { echo "    FAIL: chmod -R u+w $scratch" >&2; exit 1; }
  done
}

checkout_pin_clean() {
  local src="$1" sha="$2"
  git -C "$src" checkout --detach "$sha"
  git -C "$src" reset --hard "$sha"
}

remove_bad_src() {
  local name="$1" src="$2" host="${3:-}"
  ensure_writable_tree "$src"
  if is_linked_worktree "$src"; then
    echo "    replacing linked-worktree src with a standalone clone"
    if [[ -n "$host" ]]; then
      echo "    leftover host metadata is acceptable until: git -C $host worktree prune" >&2
    else
      echo "    leftover host metadata is acceptable until: git -C <host> worktree prune" >&2
    fi
  elif [[ -e "$src" ]]; then
    echo "    replacing src (not a reusable standalone clone)"
  fi
  rm -rf "$src"
}

ensure_remotes() {
  local src="$1" host="${2:-}" origin="${3:-}" cur
  if [[ -n "$origin" ]]; then
    if cur="$(git -C "$src" config --get remote.origin.url)"; then
      [[ "$cur" == "$origin" ]] || git -C "$src" remote set-url origin "$origin" || die "git remote set-url origin $origin in $src failed"
    else
      git -C "$src" remote add origin "$origin" || die "git remote add origin $origin in $src failed"
    fi
  fi
  if [[ -n "$host" ]]; then
    if cur="$(git -C "$src" config --get remote.host.url)"; then
      [[ "$cur" == "$host" ]] || git -C "$src" remote set-url host "$host" || die "git remote set-url host $host in $src failed"
    else
      git -C "$src" remote add host "$host" || die "git remote add host $host in $src failed"
    fi
  fi
}

check_no_submodules_lfs() {
  local src="$1" name="$2"
  [[ -e "$src/.gitmodules" ]] && {
    echo "fetch-deps: FAIL $name: source has .gitmodules (submodules are refused)" >&2
    return 1
  }
  python3 - "$src" "$name" <<'PY'
import sys
from pathlib import Path
src = Path(sys.argv[1])
name = sys.argv[2]
marker = "version https://git-lfs.github.com/spec/v1"
for p in src.rglob("*"):
    if not p.is_file():
        continue
    if ".git" in p.parts:
        continue
    try:
        if p.stat().st_size > 1024:
            continue
        head = p.read_text(encoding="utf-8", errors="replace")[:200]
    except OSError:
        continue
    if head.startswith(marker) or head.startswith("version https://git-lfs.github.com/spec/v1\n"):
        print(f"fetch-deps: FAIL {name}: Git LFS pointer file {p.relative_to(src)}", file=sys.stderr)
        sys.exit(1)
PY
}

pin_has_sources() {
  local file="$1"
  python3 - "$file" <<'PY'
import sys
import tomllib
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
sys.exit(0 if data.get("source") else 1)
PY
}

pin_is_git() {
  local file="$1" sha https ssh kind
  kind="$(pin_get_opt "$file" source_kind)" || exit 1
  if [[ "$kind" == "files" ]]; then
    return 1
  fi
  if [[ "$kind" == "seed-src" ]]; then
    return 0
  fi
  sha="$(pin_get_opt "$file" git_sha)" || exit 1
  if is_real_sha "$sha"; then
    return 0
  fi
  https="$(pin_get_opt "$file" git_https)" || exit 1
  ssh="$(pin_get_opt "$file" git_ssh)" || exit 1
  [[ -n "$https" && "$https" != "null" ]] && return 0
  [[ -n "$ssh" && "$ssh" != "null" ]] && return 0
  return 1
}

pin_source_rows() {
  local file="$1"
  python3 - "$file" <<'PY'
import sys
import tomllib
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
for s in data.get("source") or []:
    if not isinstance(s, dict):
        continue
    path = (s.get("path") or "").strip()
    sha = (s.get("sha256") or "").strip().lower()
    url = (s.get("url") or "").strip()
    seed = (s.get("seed") or "").strip()
    if not path:
        print("fetch-deps: [[source]] missing path", file=sys.stderr)
        sys.exit(2)
    if not sha:
        print(f"fetch-deps: [[source]] {path} missing sha256", file=sys.stderr)
        sys.exit(2)
    if "|" in path or "|" in url or "|" in seed:
        print(f"fetch-deps: [[source]] fields must not contain |: {path}", file=sys.stderr)
        sys.exit(2)
    print(f"{path}|{sha}|{url}|{seed}")
PY
}

source_url_is_forbidden() {
  local u="$1"
  [[ -z "$u" ]] && return 1
  case "$u" in
    git@*|ssh://*|scp://*|*@*:*) return 0 ;;
    *) return 1 ;;
  esac
}

file_sha256() {
  sha256sum "$1" | awk '{print $1}'
}

fetch_one_source() {
  local name="$1" relpath="$2" expect_sha="$3" url="$4" seed="$5"
  local pin_dir="$ROOT/$name"
  local dest src_tmp resolved=""
  dest="$(src_path "$name")/$relpath"
  mkdir -p "$(dirname "$dest")"
  ensure_writable_tree "$(dirname "$dest")"

  expect_sha="$(echo "$expect_sha" | tr 'A-F' 'a-f')"

  local had_stale=0
  if [[ -f "$dest" ]]; then
    local have
    have="$(file_sha256 "$dest")"
    if [[ "$have" == "$expect_sha" ]]; then
      echo "    source ok (cached) $relpath"
      return 0
    fi
    echo "    note: $relpath cache hash mismatch (have $have want $expect_sha) — one re-fetch" >&2
    rm -f "$dest"
    had_stale=1
  fi

  if source_url_is_forbidden "$url"; then
    echo "    FAIL: [[source]] refuses SSH/git@ URL for $relpath: $url" >&2
    return 1
  fi

  if [[ -n "$seed" ]]; then
    if [[ "$seed" = /* ]]; then
      resolved="$seed"
    else
      resolved="$pin_dir/$seed"
    fi
    if [[ ! -f "$resolved" ]]; then
      echo "    FAIL: seed not found: $resolved" >&2
      return 1
    fi
    echo "    source seed $seed → $relpath"
    cp -a "$resolved" "$dest"
  elif [[ -n "$url" ]]; then
    case "$url" in
      file:/*)
        resolved="${url#file://}"
        [[ "$resolved" == localhost/* ]] && resolved="/${resolved#localhost/}"
        if [[ ! -f "$resolved" ]]; then
          echo "    FAIL: file URL not found: $resolved" >&2
          return 1
        fi
        echo "    source file $resolved → $relpath"
        cp -a "$resolved" "$dest"
        ;;
      file:*)
        resolved="$pin_dir/${url#file:}"
        if [[ ! -f "$resolved" ]]; then
          echo "    FAIL: file: relative not found: $resolved" >&2
          return 1
        fi
        echo "    source file:$resolved → $relpath"
        cp -a "$resolved" "$dest"
        ;;
      https://*|http://*)
        command -v curl >/dev/null || { echo "    FAIL: curl required for $url" >&2; return 1; }
        src_tmp="$(mktemp)"
        echo "    source fetch $url → $relpath"
        if ! curl -fsSL --proto '=https,http' --proto-redir '=https,http' -o "$src_tmp" "$url"; then
          rm -f "$src_tmp"
          echo "    FAIL: curl download $url" >&2
          return 1
        fi
        mv "$src_tmp" "$dest"
        ;;
      *)
        echo "    FAIL: unsupported [[source]] url scheme for $relpath: $url" >&2
        echo "    (allowed: https://, http://, file:, or seed=)" >&2
        return 1
        ;;
    esac
  else
    echo "    FAIL: [[source]] $relpath needs url= or seed=" >&2
    return 1
  fi

  local got
  got="$(file_sha256 "$dest")"
  if [[ "$got" != "$expect_sha" ]]; then
    echo "    FAIL: sha256 permanent mismatch for $relpath (pin is content-addressed)" >&2
    echo "      want (libpin.toml) $expect_sha" >&2
    echo "      got  (fetched)     $got" >&2
    if [[ -n "$seed" ]]; then
      echo "      cause: seed/file content does not match pin; fix seed or update sha256" >&2
    elif [[ -n "$url" ]]; then
      echo "      cause: URL body changed or wrong sha in pin; pin a new sha256" >&2
    fi
    [[ "$had_stale" -eq 1 ]] && echo "      (cache was stale; one re-fetch still mismatched — not retrying again)" >&2
    rm -f "$dest"
    return 1
  fi
  echo "    source verified $relpath ($got)"
  return 0
}

materialize_sources() {
  local name="$1" lock relpath sha url seed n=0
  lock="$(pin_path "$name")"
  pin_has_sources "$lock" || return 0
  echo "    materialize [[source]] for $name"
  while IFS='|' read -r relpath sha url seed; do
    [[ -z "$relpath" ]] && continue
    fetch_one_source "$name" "$relpath" "$sha" "$url" "$seed" || return 1
    n=$((n + 1))
  done < <(pin_source_rows "$lock")
  [[ "$n" -gt 0 ]] || {
    echo "    FAIL: [[source]] present but no rows parsed" >&2
    return 1
  }
  echo "    sources: $n file(s) under $(src_path "$name")"
  return 0
}

reject_file_pin_patches() {
  local name="$1" lock="$2"
  if pin_has_key "$lock" patches; then
    echo "fetch-deps: FAIL $name: file pins cannot have a patches key" >&2
    return 1
  fi
  if [[ -d "$ROOT/$name/patches" ]]; then
    echo "fetch-deps: FAIL $name: file pins cannot have a patches/ directory" >&2
    return 1
  fi
}

list_patch_files() {
  local name="$1" lock="$2"
  python3 - "$lock" "$ROOT/$name" <<'PY'
import sys
import tomllib
from pathlib import Path
pin = Path(sys.argv[1])
pin_dir = Path(sys.argv[2])
data = tomllib.loads(pin.read_text(encoding="utf-8"))
if "patches" in data:
    items = data["patches"] or []
    if isinstance(items, str):
        items = [items]
    for raw in items:
        p = str(raw).strip()
        if not p:
            continue
        if p.startswith("/") or ".." in Path(p).parts:
            print(f"fetch-deps: FAIL patch path rejected: {p}", file=sys.stderr)
            sys.exit(2)
        print(str(pin_dir / p))
    sys.exit(0)
pdir = pin_dir / "patches"
if not pdir.is_dir():
    sys.exit(0)
files = sorted([p for p in pdir.iterdir() if p.suffix in (".patch", ".diff") and p.is_file()], key=lambda p: p.name)
for p in files:
    print(str(p))
PY
}

apply_patches() {
  local name="$1" src="$2" pin="$3"
  local f created plist
  plist="$(list_patch_files "$name" "$pin")" || return 1
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    [[ -f "$f" ]] || { echo "    FAIL: patch not found: $f" >&2; return 1; }
    echo "    apply patch $(basename "$f")  [sandbox=src]"
    while IFS= read -r created; do
      [[ -n "$created" ]] || continue
      if [[ -e "$src/$created" ]]; then
        if [[ -z "$(git -C "$src" ls-files -- "$created")" ]]; then
          echo "    remove stale untracked $created (created by $(basename "$f"))"
          rm -f -- "$src/$created"
        fi
      fi
    done < <({ git -C "$src" apply --summary "$f" | sed -n 's/^ create mode [0-9]* //p'
               awk '/^\+\+\+ /{p=$2; sub(/^b\//,"",p); next} /^@@ -0,0 /{if(p!=""){print p; p=""}} /^@@/{p=""}' "$f"; } | sort -u)
    if ! bwrap_src "$name" bash -c "cd $(printf %q "$src") && git apply --whitespace=nowarn $(printf %q "$f")"; then
      echo "    FAIL: patch $f" >&2
      return 1
    fi
  done <<< "$plist"
  return 0
}

lookup_track_kind() {
  local host="$1" track="$2" tag=0 branch=0
  if git_host "$host" show-ref --verify --quiet "refs/tags/$track"; then
    tag=1
  fi
  if git_host "$host" show-ref --verify --quiet "refs/heads/$track"; then
    branch=1
  fi
  if [[ "$tag" -eq 1 && "$branch" -eq 1 ]]; then
    echo "fetch-deps: track_branch $track is both a tag and a branch in $host" >&2
    return 1
  fi
  if [[ "$tag" -eq 1 ]]; then
    echo tag
    return 0
  fi
  if [[ "$branch" -eq 1 ]]; then
    echo branch
    return 0
  fi
  echo "fetch-deps: track_branch $track not found as refs/tags/$track or refs/heads/$track in $host" >&2
  return 1
}

# stdout: "tag SHA" or "branch SHA"
remote_ls_track() {
  local url="$1" track="$2" name="$3" ls rc=0 nheads ntags tip kind
  if is_ssh_url "$url"; then
    prepare_ssh_transport
  fi
  rc=0
  ls="$(git ls-remote "$url" "refs/heads/$track" "refs/tags/$track" "refs/tags/$track^{}" 2>&1)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "fetch-deps: git ls-remote $url failed: $ls" >&2
    if is_ssh_url "$url"; then
      report_owner_ssh "$url" "$(src_path "$name")" "$ls"
    fi
    return 1
  fi
  nheads="$(printf '%s\n' "$ls" | awk -v r="refs/heads/$track" '$2==r{c++} END{print c+0}')"
  ntags="$(printf '%s\n' "$ls" | awk -v r="refs/tags/$track" '$2==r{c++} END{print c+0}')"
  if [[ "$nheads" -gt 0 && "$ntags" -gt 0 ]]; then
    echo "fetch-deps: track_branch $track is both a tag and a branch on $url" >&2
    return 1
  fi
  if [[ "$ntags" -gt 0 ]]; then
    kind=tag
    tip="$(printf '%s\n' "$ls" | awk -v r="refs/tags/$track^{}" '$2==r{print $1; found=1} END{if(found) exit 0; exit 1}')" \
      || tip="$(printf '%s\n' "$ls" | awk -v r="refs/tags/$track" '$2==r{print $1; found=1} END{if(found) exit 0; exit 1}')"
  elif [[ "$nheads" -gt 0 ]]; then
    kind=branch
    tip="$(printf '%s\n' "$ls" | awk -v r="refs/heads/$track" '$2==r{print $1; found=1} END{if(found) exit 0; exit 1}')"
  else
    echo "fetch-deps: track_branch $track not on $url" >&2
    return 1
  fi
  [[ -n "$tip" ]] || { echo "fetch-deps: ls-remote $url had $track but no sha" >&2; return 1; }
  printf '%s %s\n' "$kind" "$tip"
}

write_pin_sha() {
  local pin="$1" sha="$2" describe="$3" src="${4:-}"
  if [[ -n "$src" ]]; then
    assert_src_toplevel "$src" || return 1
  fi
  python3 - "$pin" "$sha" "$describe" <<'PY'
import os, re, sys
from pathlib import Path
path, sha, desc = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
for label, val in (("git_sha", sha), ("git_describe", desc)):
    if any(c in val for c in '"\\\n'):
        sys.exit(f"fetch-deps: {label} contains illegal characters")
text = path.read_text(encoding="utf-8")
parts = re.split(r"(?m)^\[", text, maxsplit=1)
head = parts[0]
rest = "[" + parts[1] if len(parts) > 1 else ""

def repl_or_add(head, key, val):
    pat = re.compile(r"(?m)^" + re.escape(key) + r"\s*=\s*.*$")
    if pat.search(head):
        return pat.sub(f'{key} = "{val}"', head, count=1)
    stripped = head.rstrip()
    return stripped + ("" if stripped.endswith("\n") or stripped == "" else "\n") + f'{key} = "{val}"\n'

head = repl_or_add(head, "git_sha", sha)
head = repl_or_add(head, "git_describe", desc)
if not head.endswith("\n") and rest:
    head += "\n"
tmp = str(path) + ".tmp"
Path(tmp).write_text(head + rest, encoding="utf-8")
os.replace(tmp, path)
PY
}

describe_at() {
  local repo="$1" sha="$2" how="$3" desc
  if [[ "$how" == host ]]; then
    if desc="$(git_host "$repo" describe --tags --long --always "$sha")"; then
      printf '%s\n' "$desc"
      return 0
    fi
  else
    if desc="$(git -C "$repo" describe --tags --long --always "$sha")"; then
      printf '%s\n' "$desc"
      return 0
    fi
  fi
  printf '%s\n' "$sha"
}

# rc 0 = done; 1 = hard fail; 3 = host unusable, caller should use remote.
materialize_from_host() {
  local name="$1" sha="$2" host="$3" src="$4" origin="$5" full err rc=0
  if [[ ! -r "$host" || ! -x "$host" ]]; then
    report_owner_host_perm "$host" "$name"
    return 3
  fi
  rc=0
  full="$(git_host "$host" rev-parse --verify "${sha}^{commit}" 2>&1)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "fetch-deps: cannot resolve '$sha' in host $host: $full" >&2
    if [[ "$full" == *"ambiguous"* ]]; then
      echo "fetch-deps: sha '$sha' is ambiguous in $host" >&2
      return 1
    fi
    if [[ "$full" == *"Permission denied"* || "$full" == *"dubious ownership"* ]]; then
      report_owner_host_perm "$host" "$name" "$full"
      return 3
    fi
    echo "fetch-deps: host $host does not have $sha; using remote if present" >&2
    return 3
  fi
  if [[ -d "$src" ]] && is_standalone_clone "$src"; then
    local has=0 hrc=0
    repo_has_commit "$src" "$full" src && has=1 || hrc=$?
    [[ "$hrc" -eq 2 ]] && return 1
    if [[ "$has" -eq 1 ]]; then
      echo "    reuse standalone src @ $full"
      checkout_pin_clean "$src" "$full"
      ensure_remotes "$src" "$host" "$origin"
      check_no_submodules_lfs "$src" "$name" || return 1
      return 0
    fi
    echo "    fetch $full from host into existing src"
    if ! err="$(git -c "safe.directory=$host" -C "$src" fetch "$host" "$full" 2>&1)"; then
      echo "$err" >&2
      if [[ "$err" == *"Permission denied"* || "$err" == *"dubious ownership"* ]]; then
        report_owner_host_perm "$host" "$name" "$err"
        return 3
      fi
      echo "fetch-deps: FAIL $name: fetch $full from host $host failed" >&2
      return 1
    fi
    checkout_pin_clean "$src" "$full"
    ensure_remotes "$src" "$host" "$origin"
    check_no_submodules_lfs "$src" "$name" || return 1
    return 0
  fi
  if [[ -e "$src" ]]; then
    remove_bad_src "$name" "$src" "$host"
  fi
  echo "    clone --no-hardlinks --no-checkout $host → $src"
  if ! err="$(git -c "safe.directory=$host" clone --no-hardlinks --no-checkout "$host" "$src" 2>&1)"; then
    echo "$err" >&2
    if [[ "$err" == *"Permission denied"* || "$err" == *"dubious ownership"* ]]; then
      report_owner_host_perm "$host" "$name" "$err"
      return 3
    fi
    echo "fetch-deps: FAIL $name: clone from host $host failed" >&2
    return 1
  fi
  git -C "$src" checkout --detach "$full"
  ensure_remotes "$src" "$host" "$origin"
  check_no_submodules_lfs "$src" "$name" || return 1
  echo "    checkout --detach $full (host $host)"
  return 0
}

remote_fetch() {
  local src="$1" url="$2" sha="$3" name="$4" err
  if is_ssh_url "$url"; then
    prepare_ssh_transport
  fi
  if ! err="$(git -C "$src" fetch origin "$sha" 2>&1)"; then
    echo "$err" >&2
    if is_ssh_url "$url" || [[ "$err" == *"Permission denied"* && "$err" == *"publickey"* ]]; then
      report_owner_ssh "$url" "$src" "$err"
    fi
    echo "fetch-deps: FAIL $name: git fetch $url $sha failed" >&2
    return 1
  fi
  return 0
}

materialize_from_remote() {
  local name="$1" sha="$2" url="$3" src="$4" full
  if [[ -d "$src" ]] && is_standalone_clone "$src"; then
    local has=0 rc=0
    repo_has_commit "$src" "$sha" src && has=1 || rc=$?
    [[ "$rc" -eq 2 ]] && return 1
    if [[ "$has" -eq 1 ]]; then
      full="$(resolve_commit "$src" "$sha" src)" || return 1
      echo "    reuse standalone src @ $full"
      checkout_pin_clean "$src" "$full"
      ensure_remotes "$src" "" "$url"
      check_no_submodules_lfs "$src" "$name" || return 1
      return 0
    fi
    echo "    fetch $sha from origin $url"
    ensure_remotes "$src" "" "$url"
    remote_fetch "$src" "$url" "$sha" "$name" || return 1
    full="$(resolve_commit "$src" "$sha" src)" || return 1
    checkout_pin_clean "$src" "$full"
    check_no_submodules_lfs "$src" "$name" || return 1
    return 0
  fi
  if [[ -e "$src" ]]; then
    remove_bad_src "$name" "$src" ""
  fi
  mkdir -p "$src"
  echo "    git init + fetch $sha from $url"
  git -C "$src" init
  git -C "$src" remote add origin "$url"
  remote_fetch "$src" "$url" "$sha" "$name" || return 1
  full="$(resolve_commit "$src" "$sha" src)" || return 1
  git -C "$src" checkout --detach "$full"
  check_no_submodules_lfs "$src" "$name" || return 1
  return 0
}

materialize_seed_src() {
  local name="$1" src="$2"
  [[ -x "$ROOT/$name/seed-src" ]] || {
    echo "fetch-deps: FAIL $name: source_kind=seed-src but $ROOT/$name/seed-src is not executable" >&2
    return 1
  }
  echo "    seed-src"
  ensure_writable_tree "$src"
  rm -rf "$src"
  ( cd "$ROOT/$name" && ./seed-src ) || return 1
  check_no_submodules_lfs "$src" "$name" || return 1
  return 0
}

resolve_pin_sha_for() {
  local name="$1" lock sha track host rc=0 kind url info
  lock="$(pin_path "$name")"
  sha="$(pin_get_opt "$lock" git_sha)" || exit 1
  if is_real_sha "$sha"; then
    RESOLVED_SHA="$sha"
    RESOLVED_DESCRIBE="$(pin_get_opt "$lock" git_describe)" || exit 1
    [[ -n "$RESOLVED_DESCRIBE" ]] || RESOLVED_DESCRIBE="$sha"
    return 0
  fi
  track="$(pin_get_opt "$lock" track_branch)" || exit 1
  [[ -n "$track" ]] || {
    echo "fetch-deps: FAIL $name: no git_sha and no track_branch" >&2
    return 1
  }
  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if [[ "$rc" -eq 0 ]]; then
    kind="$(lookup_track_kind "$host" "$track")" || return 1
    if [[ "$kind" == tag ]]; then
      RESOLVED_SHA="$(resolve_commit "$host" "refs/tags/$track" host)" || return 1
    else
      RESOLVED_SHA="$(resolve_commit "$host" "refs/heads/$track" host)" || return 1
    fi
    RESOLVED_DESCRIBE="$(describe_at "$host" "$RESOLVED_SHA" host)"
    return 0
  fi
  url="$(pin_remote_url "$name")" || {
    echo "fetch-deps: FAIL $name: no git_sha and no host or remote to resolve track_branch $track" >&2
    return 1
  }
  info="$(remote_ls_track "$url" "$track" "$name")" || return 1
  kind="${info%% *}"
  RESOLVED_SHA="${info#* }"
  RESOLVED_DESCRIBE="$RESOLVED_SHA"
  echo "    track_branch $track ($kind) @ $RESOLVED_SHA from $url"
  return 0
}

materialize_from_url_or_seed() {
  local name="$1" sha="$2" src="$3" kind url
  url="$(pin_remote_url "$name")" && {
    echo "    remote $url"
    materialize_from_remote "$name" "$sha" "$url" "$src"
    return $?
  }
  kind="$(pin_get_opt "$(pin_path "$name")" source_kind)" || exit 1
  if [[ "$kind" == "seed-src" ]]; then
    materialize_seed_src "$name" "$src"
    return $?
  fi
  echo "fetch-deps: FAIL $name: no usable host shortcut and no git_https/git_ssh (source_kind is not seed-src)" >&2
  return 1
}

# Declared fallback, printed: host shortcut, else git_https, else git_ssh, else seed-src.
materialize_git() {
  local name="$1" sha="$2" src lock origin host rc=0 hrc=0
  src="$(src_path "$name")"
  lock="$(pin_path "$name")"
  origin="$(pin_remote_url "$name")" || origin=""

  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if [[ "$rc" -eq 0 ]]; then
    echo "    host $host (offline shortcut)"
    hrc=0
    materialize_from_host "$name" "$sha" "$host" "$src" "$origin" || hrc=$?
    if [[ "$hrc" -eq 0 ]]; then
      return 0
    fi
    if [[ "$hrc" -ne 3 ]]; then
      return 1
    fi
    echo "    host shortcut unusable; declared fallback to remote" >&2
  fi
  materialize_from_url_or_seed "$name" "$sha" "$src"
}

cmd_ro() {
  local name="$1"
  if should_reenter; then
    echo "    [sandbox=lib $name]"
    reenter_self lib "$name" ro
    return $?
  fi
  local lock src sha kind="git" need_rw
  lock="$(pin_path "$name")"
  src="$(src_path "$name")"
  [[ -f "$lock" ]] || { echo "FAIL $name: no libpin.toml" >&2; return 1; }
  [[ -r "$lock" ]] || { echo "FAIL $name: cannot read libpin.toml" >&2; return 1; }
  echo "==> $name  mode=ro  GIT_HOME=$GIT_HOME"

  if ! pin_is_git "$lock"; then
    reject_file_pin_patches "$name" "$lock" || return 1
    if ! pin_has_sources "$lock"; then
      echo "    FAIL: non-git pin needs [[source]] rows" >&2
      return 1
    fi
    kind="files"
    echo "    pin=files (non-git [[source]])"
    ensure_writable_tree "$src"
    mkdir -p "$src"
    materialize_sources "$name" || return 1
    sha="files"
  else
    resolve_pin_sha_for "$name" || return 1
    sha="$RESOLVED_SHA"
    echo "    pin=$sha"
    materialize_git "$name" "$sha" || return 1
    ensure_writable_tree "$src"
    apply_patches "$name" "$src" "$lock" || return 1
    if pin_has_sources "$lock"; then
      materialize_sources "$name" || return 1
    fi
  fi

  need_rw="$(pin_get_opt "$lock" requires_writable_src)" || exit 1
  if [[ "$need_rw" == "true" || "$need_rw" == "yes" || "$need_rw" == "1" ]]; then
    write_status "$name" "ro" "" "$sha" "kind: $kind"$'\n'"readonly: false  # requires_writable_src"
    echo "    WRITABLE SRC (requires_writable_src)"
  else
    make_readonly_tree "$src"
    write_status "$name" "ro" "" "$sha" "kind: $kind"$'\n'"readonly: true"
    echo "    READ-ONLY PIN: build scripts may chmod only build/bin dirs under src"
  fi
  if [[ "$kind" == "git" ]]; then
    echo "    OK $name @ $(git -C "$src" rev-parse --short HEAD)"
  else
    echo "    OK $name (files pin)"
  fi
}

cmd_rw() {
  local name="$1"
  if should_reenter; then
    echo "    [sandbox=lib $name]"
    reenter_self lib "$name" rw
    return $?
  fi
  local lock src sha branch base host rc=0 https
  lock="$(pin_path "$name")"
  src="$(src_path "$name")"
  branch="${BRANCH_OVERRIDE:-work}"
  echo "==> $name  mode=rw  branch=$branch  GIT_HOME=$GIT_HOME"

  if ! pin_is_git "$lock"; then
    reject_file_pin_patches "$name" "$lock" || return 1
    if pin_has_sources "$lock"; then
      mkdir -p "$src"
      ensure_writable_tree "$src"
      materialize_sources "$name" || return 1
      ensure_writable_tree "$src"
      write_status "$name" "rw" "" "files" "kind: files"$'\n'"readonly: false"
      echo "    RW files pin (no git branch)"
      echo "    OK $name (files)"
      return 0
    fi
    echo "    FAIL: non-git pin needs [[source]] for rw" >&2
    return 1
  fi

  resolve_pin_sha_for "$name" || return 1
  base="${BASE_REF:-$RESOLVED_SHA}"
  materialize_git "$name" "$base" || return 1
  ensure_writable_tree "$src"
  git -C "$src" checkout -B "$branch" "$base"
  echo "    branch $branch @ $base"
  apply_patches "$name" "$src" "$lock" || {
    echo "    FAIL $name: patch did not apply; tree left as is, nothing built" >&2
    return 1
  }
  write_status "$name" "rw" "$branch" "$(git -C "$src" rev-parse HEAD)" "readonly: false"
  host=""
  rc=0
  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if [[ "$rc" -eq 0 ]]; then
    echo "    owner ($(stat -c '%U' "$host")): git -C $src push host HEAD:refs/heads/$branch"
  fi
  echo "    RW: commits stay in src until pushed to the host"
  echo "    OK $name @ $(git -C "$src" rev-parse --short HEAD) branch=$branch"
}

cmd_status() {
  local name="$1"
  local lock src sp mode head locksha kind dirty="n" relpath sha url seed got
  lock="$(pin_path "$name")"
  src="$(src_path "$name")"
  sp="$(status_path "$name")"
  locksha="$(pin_get_opt "$lock" git_sha)" || exit 1
  [[ -n "$locksha" ]] || locksha="?"
  mode="?"
  head="?"
  if [[ -f "$sp" ]]; then
    mode="$(status_get "$sp" mode)"
    [[ -n "$mode" ]] || mode="?"
  fi
  if pin_is_git "$lock"; then
    kind="git"
    if [[ -d "$src/.git" || -f "$src/.git" ]]; then
      head="$(git -C "$src" rev-parse --short HEAD)"
    else
      head="(no src)"
    fi
  else
    kind="files"
    locksha="files"
    if [[ -d "$src" ]]; then
      head="files"
    else
      head="(no src)"
    fi
  fi
  if [[ "$kind" == "git" ]] && { [[ -d "$src/.git" ]] || [[ -f "$src/.git" ]]; }; then
    if [[ -n "$(git -C "$src" status --porcelain)" ]]; then dirty="Y"; fi
  elif [[ "$kind" == "files" && -d "$src" ]] && pin_has_sources "$lock"; then
    while IFS='|' read -r relpath sha url seed; do
      [[ -z "$relpath" ]] && continue
      if [[ ! -f "$src/$relpath" ]]; then dirty="Y"; break; fi
      got="$(file_sha256 "$src/$relpath")"
      [[ "$got" != "$sha" ]] && { dirty="Y"; break; }
    done < <(pin_source_rows "$lock")
  fi
  echo "$name: mode=$mode kind=$kind head=$head pin=${locksha:0:12}… dirty=$dirty"
  if [[ "$VERBOSE" -ge 1 ]]; then
    [[ -f "$sp" ]] && sed 's/^/  /' "$sp"
    if [[ "$dirty" == "Y" && "$kind" == "git" ]]; then
      echo "  dirty files:"
      git -C "$src" status --short | sed 's/^/    /'
    fi
    if [[ "$kind" == "git" && "$head" != "(no src)" && -n "$locksha" && "$locksha" != "?" ]]; then
      if ! git -C "$src" rev-parse --verify "${locksha}^{commit}"; then
        echo "  issue: lock sha not in src"
      elif [[ "$(git -C "$src" rev-parse HEAD)" != "$(git -C "$src" rev-parse "$locksha")" ]]; then
        echo "  issue: HEAD != lock sha (ok if mode=rw)"
      fi
    fi
    if [[ "$kind" == "files" ]] && pin_has_sources "$lock"; then
      while IFS='|' read -r relpath sha url seed; do
        [[ -z "$relpath" ]] && continue
        if [[ -f "$src/$relpath" ]]; then
          got="$(file_sha256 "$src/$relpath")"
          if [[ "$got" == "$sha" ]]; then
            echo "  source OK $relpath"
          else
            echo "  source BAD $relpath (want $sha got $got)"
          fi
        else
          echo "  source MISSING $relpath"
        fi
      done < <(pin_source_rows "$lock")
    fi
  fi
  if [[ "$VERBOSE" -ge 2 && "$kind" == "git" ]] && { [[ -d "$src/.git" ]] || [[ -f "$src/.git" ]]; }; then
    git -C "$src" status | sed 's/^/  /'
  fi
}

cmd_refresh() {
  local name="$1" host sha desc track kind pin_sha rc=0 src src_arg="" url info
  if should_reenter; then
    echo "    [sandbox=lib $name]"
    reenter_self lib "$name" refresh
    return $?
  fi
  echo "==> $name  refresh"
  if ! pin_is_git "$(pin_path "$name")"; then
    echo "    FAIL: refresh is git-only; file pins bump sha256 in libpin.toml by hand" >&2
    return 1
  fi
  track="$(pin_get_opt "$(pin_path "$name")" track_branch)" || exit 1
  [[ -n "$track" ]] || { echo "    FAIL: refresh needs track_branch" >&2; return 1; }
  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if [[ "$rc" -eq 0 ]]; then
    kind="$(lookup_track_kind "$host" "$track")" || return 1
    resolve_pin_sha_for "$name" || return 1
    pin_sha="$(resolve_commit "$host" "$RESOLVED_SHA" host)" || return 1
    if [[ "$kind" == tag ]]; then
      sha="$(resolve_commit "$host" "refs/tags/$track" host)" || return 1
      if [[ "$sha" != "$pin_sha" ]]; then
        echo "    FAIL: tag moved: track_branch $track now $sha, pin is $pin_sha (use upgrade --ref)" >&2
        return 1
      fi
      echo "    tag $track still at pin $pin_sha"
      cmd_ro "$name"
      return $?
    fi
    sha="$(resolve_commit "$host" "refs/heads/$track" host)" || return 1
    desc="$(describe_at "$host" "$sha" host)"
  else
    url="$(pin_remote_url "$name")" || {
      echo "    FAIL: refresh needs a host shortcut or git_https/git_ssh for $name" >&2
      return 1
    }
    info="$(remote_ls_track "$url" "$track" "$name")" || return 1
    kind="${info%% *}"
    sha="${info#* }"
    resolve_pin_sha_for "$name" || return 1
    pin_sha="$RESOLVED_SHA"
    if [[ "$kind" == tag ]]; then
      if [[ "$sha" != "$pin_sha" ]]; then
        echo "    FAIL: tag moved: track_branch $track now $sha, pin is $pin_sha (use upgrade --ref)" >&2
        return 1
      fi
      echo "    tag $track still at pin $pin_sha"
      cmd_ro "$name"
      return $?
    fi
    desc="$sha"
  fi
  src="$(src_path "$name")"
  if [[ -d "$src/.git" || -f "$src/.git" ]]; then
    src_arg="$src"
  fi
  write_pin_sha "$(pin_path "$name")" "$sha" "$desc" "$src_arg"
  echo "    pin → $sha ($desc)"
  cmd_ro "$name"
}

record_artifact_shas() {
  local pin="$1" records="$2"
  python3 - "$pin" "$records" <<'PY'
import os, re, sys
pin, records = sys.argv[1], sys.argv[2]
recs = []
count = None
for line in records.splitlines():
    f = line.split("\t")
    if f[0] == "ARTIFACT-COUNT" and len(f) == 2:
        count = int(f[1])
    elif f[0] == "ARTIFACT-SHA256" and len(f) == 4:
        recs.append((int(f[1]), f[2], f[3]))
lines = open(pin, encoding="utf-8").read().split("\n")
starts = [i for i, l in enumerate(lines) if l.strip() == "[[artifact]]"]
if count is None:
    sys.exit(f"fetch-deps: {pin}: get-artifacts did not report ARTIFACT-COUNT")
if count != len(starts):
    sys.exit(f"fetch-deps: {pin}: ARTIFACT-COUNT {count} != {len(starts)} [[artifact]] tables")
for idx, old, new in recs:
    if idx >= len(starts):
        sys.exit(f"fetch-deps: {pin}: no [[artifact]] row {idx}")
    end = next((j for j in range(starts[idx] + 1, len(lines)) if re.match(r"^\s*\[", lines[j])), len(lines))
    if old == "MISSING":
        hits = [j for j in range(starts[idx] + 1, end) if re.match(r"\s*sha256\s*=", lines[j])]
        if hits:
            sys.exit(f"fetch-deps: {pin}: [[artifact]] row {idx} already has sha256 (parser said MISSING)")
        insert_at = starts[idx] + 1
        lines.insert(insert_at, f'sha256 = "{new}"')
        for k, s in enumerate(starts):
            if s >= insert_at:
                starts[k] = s + 1
        print(f"    pin row {idx}: inserted sha256 {new[:12]}…")
        continue
    hits = [j for j in range(starts[idx] + 1, end) if re.fullmatch(r'\s*sha256\s*=\s*"' + re.escape(old) + r'"\s*', lines[j])]
    if len(hits) != 1:
        sys.exit(f"fetch-deps: {pin}: [[artifact]] row {idx} has no single sha256 = \"{old}\" line")
    lines[hits[0]] = f'sha256 = "{new}"'
    print(f"    pin row {idx}: sha256 {old[:12]}… -> {new[:12]}…")
tmp = pin + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines))
os.replace(tmp, pin)
PY
}

cmd_build() {
  local name="$1"
  local ga_mode="${2:-verify}"
  local dir="$ROOT/$name"
  local lock src need_rw
  lock="$(pin_path "$name")"
  src="$(src_path "$name")"
  echo "==> $name  build"
  if [[ ! -d "$src" ]]; then
    echo "    FAIL: no src — run fetch-deps first" >&2
    return 1
  fi
  need_rw="$(pin_get_opt "$lock" requires_writable_src)" || exit 1
  if [[ "$need_rw" == "true" || "$need_rw" == "yes" || "$need_rw" == "1" ]]; then
    ensure_writable_tree "$src"
  fi
  run_build_cmd() {
    local bcmd="$1"
    echo "    run $bcmd  [sandbox=src]"
    bwrap_src "$name" bash -c "cd $(printf %q "$dir") && eval $(printf %q "$bcmd")"
  }
  local ran=0 bcmd
  while IFS= read -r bcmd; do
    [[ -z "$bcmd" ]] && continue
    run_build_cmd "$bcmd" || { echo "    FAIL build: $bcmd" >&2; return 1; }
    ran=1
  done < <(pin_build_steps "$lock")
  if [[ "$ran" -eq 0 ]]; then
    echo "    no build steps — skip exec"
  fi
  if [[ -x "$ROOT/get-artifacts" ]]; then
    if grep -q '\[\[artifact\]\]' "$lock"; then
      echo "    get-artifacts --$ga_mode"
      local ga_out ga_flag=() caps
      if [[ "$ga_mode" == record ]]; then
        if ! caps=$("$ROOT/get-artifacts" --capabilities) || [[ "$caps" != record ]]; then
          echo "    FAIL: $ROOT/get-artifacts has no --record (older copy)" >&2
          return 1
        fi
        ga_flag=(--record)
      fi
      ga_out=$(LIBPIN_NO_BWRAP=1 LIBPIN_NO_LANDLOCK=1 "$ROOT/get-artifacts" --no-bwrap --no-landlock "${ga_flag[@]}" "$name") \
        || { printf '%s\n' "$ga_out" | grep -v '^ARTIFACT-'; echo "    FAIL get-artifacts" >&2; return 1; }
      printf '%s\n' "$ga_out" | grep -v '^ARTIFACT-' || [[ $? -eq 1 ]]
      if [[ "$ga_mode" == record ]]; then
        record_artifact_shas "$lock" "$ga_out" || { echo "    FAIL: could not record new sha256 values in $lock" >&2; return 1; }
      fi
    else
      echo "    no [[artifact]] — skip get-artifacts"
    fi
  fi
  local mode=""
  if [[ -f "$(status_path "$name")" ]]; then
    mode="$(status_get "$(status_path "$name")" mode)"
  fi
  [[ -n "$mode" ]] || mode="ro"
  if [[ "$mode" == "ro" && "$need_rw" != "true" ]]; then
    finish_ro_tree "$src"
  fi
  echo "    OK build $name"
}

clean_src_for_rebuild() {
  local src="$1"
  git -C "$src" clean -xfd
  local d
  for d in "$src/build" "$src/bin"; do
    if [[ -e "$d" ]]; then
      rm -rf "$d"
    fi
  done
}

UPGRADE_LOCK="" UPGRADE_BACKUP=""
restore_upgrade_pin() {
  [[ -n "$UPGRADE_BACKUP" && -f "$UPGRADE_BACKUP" ]] || return 0
  cp -p "$UPGRADE_BACKUP" "$UPGRADE_LOCK" && rm -f "$UPGRADE_BACKUP" \
    && echo "    upgrade stopped: $UPGRADE_LOCK restored" >&2
}

cmd_upgrade() {
  local name="$1" ref="$REF_UPGRADE" src host sha branch rc=0 lock backup repro desc
  echo "==> $name  upgrade --ref $ref"
  if ! pin_is_git "$(pin_path "$name")"; then
    echo "    FAIL: upgrade is git-only; for file pins edit [[source]] url/sha256 then fetch-deps ro" >&2
    return 1
  fi
  src="$(src_path "$name")"
  branch="${BRANCH_OVERRIDE:-upgrade/$ref}"
  if should_reenter; then
    echo "    [sandbox=lib $name]"
    reenter_self lib "$name" upgrade
    return $?
  fi
  materialize_git "$name" "$ref" || return 1
  ensure_writable_tree "$src"
  git -C "$src" checkout -B "$branch" "$ref"
  sha="$(git -C "$src" rev-parse HEAD)"
  if ! apply_patches "$name" "$src" "$(pin_path "$name")"; then
    echo "    FAIL upgrade $name: patch did not apply at $sha; not building, lock unchanged" >&2
    return 1
  fi
  write_status "$name" "rw" "$branch" "$sha" "upgrade_ref: $ref"$'\n'"readonly: false"
  host=""
  rc=0
  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if [[ "$rc" -eq 0 ]]; then
    echo "    owner ($(stat -c '%U' "$host")): git -C $src push host HEAD:refs/heads/$branch"
  fi
  lock="$(pin_path "$name")"
  backup="$(mktemp "$lock.before-upgrade.XXXXXX")"
  cp -p "$lock" "$backup"
  UPGRADE_LOCK="$lock" UPGRADE_BACKUP="$backup"
  trap restore_upgrade_pin EXIT
  clean_src_for_rebuild "$src"
  if ! cmd_build "$name" record; then
    cp -p "$backup" "$lock"; rm -f "$backup"
    UPGRADE_BACKUP=""
    echo "    FAIL upgrade $name: build failed at $sha; lock unchanged; src branch $branch kept" >&2
    return 1
  fi
  repro="$(pin_get_opt "$lock" reproducible)" || exit 1
  if [[ "$repro" == "true" ]]; then
    echo "    reproducible = true: second build must give the recorded bytes"
    clean_src_for_rebuild "$src"
    if ! cmd_build "$name" verify; then
      cp -p "$backup" "$lock"; rm -f "$backup"
      UPGRADE_BACKUP=""
      echo "    FAIL upgrade $name: second build differs from the first (not reproducible); lock unchanged; src branch $branch kept" >&2
      return 1
    fi
  fi
  rm -f "$backup"
  UPGRADE_BACKUP=""
  trap - EXIT
  assert_src_toplevel "$src" || return 1
  desc="$(describe_at "$src" "$sha" src)"
  write_pin_sha "$lock" "$sha" "$desc" "$src"
  git -C "$src" checkout --detach "$sha"
  git -C "$src" branch -D "$branch"
  finish_ro_tree "$src"
  write_status "$name" "ro" "" "$sha" "kind: git"$'\n'"readonly: true"
  echo "    upgraded pin to $sha — review artifact/ and commit"
  echo "    OK upgrade $name"
}

toml_git_sha() {
  python3 - "$1" <<'PY'
import sys, tomllib
from pathlib import Path
data = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
v = data.get("git_sha")
if v is None:
    sys.exit(3)
print(v)
PY
}

check_depends() {
  local name="$1" lock dep consumer_sha expected src host rc=0 pin_sha blob tmp
  lock="$(pin_path "$name")"
  pin_has_key "$lock" depends || return 0
  resolve_pin_sha_for "$name" || return 1
  pin_sha="$RESOLVED_SHA"
  src="$(src_path "$name")"
  host=""
  rc=0
  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  while IFS= read -r dep; do
    [[ -n "$dep" ]] || continue
    [[ -f "$(pin_path "$dep")" ]] || { echo "    FAIL $name: depends on $dep but $(pin_path "$dep") is missing" >&2; return 1; }
    consumer_sha="$(pin_get_opt "$(pin_path "$dep")" git_sha)" || exit 1
    [[ -n "$consumer_sha" ]] || { echo "    FAIL $name: dep $dep has no git_sha" >&2; return 1; }
    blob=""
    if [[ -f "$src/third_party/$dep/libpin.toml" ]]; then
      blob="$src/third_party/$dep/libpin.toml"
      expected="$(toml_git_sha "$blob")" || { echo "    FAIL $name: cannot read git_sha from $blob" >&2; return 1; }
    elif [[ "$rc" -eq 0 ]]; then
      tmp="$(mktemp)"
      if git_host "$host" show "${pin_sha}:third_party/${dep}/libpin.toml" >"$tmp"; then
        expected="$(toml_git_sha "$tmp")" || { rm -f "$tmp"; echo "    FAIL $name: cannot read git_sha from host ${pin_sha}:third_party/${dep}/libpin.toml" >&2; return 1; }
        rm -f "$tmp"
      else
        rm -f "$tmp"
        echo "    FAIL $name: depends $dep: need host or src (no third_party/$dep/libpin.toml at $pin_sha)" >&2
        return 1
      fi
    else
      echo "    FAIL $name: depends $dep: need host or src" >&2
      return 1
    fi
    local full_c full_e dep_host dep_rc=0
    dep_host="$(local_repo_for "$dep")" || dep_rc=$?
    [[ "$dep_rc" -eq 2 ]] && return 1
    if [[ "$dep_rc" -eq 0 ]]; then
      full_c="$(resolve_commit "$dep_host" "$consumer_sha" host)" || return 1
      full_e="$(resolve_commit "$dep_host" "$expected" host)" || return 1
    elif [[ -d "$(src_path "$dep")/.git" || -f "$(src_path "$dep")/.git" ]]; then
      full_c="$(resolve_commit "$(src_path "$dep")" "$consumer_sha" src)" || return 1
      full_e="$(resolve_commit "$(src_path "$dep")" "$expected" src)" || return 1
    else
      full_c="$consumer_sha"
      full_e="$expected"
    fi
    if [[ "$full_c" != "$full_e" ]]; then
      echo "    FAIL $name: depends $dep mismatch: this tree pins $full_c, $name@$pin_sha wants $full_e" >&2
      return 1
    fi
    echo "    depends $dep OK ($full_c)"
  done < <(pin_get "$lock" depends)
}

check_git_home_leak() {
  local name="$1" lock
  lock="$(pin_path "$name")"
  if [[ -n "${GIT_HOME:-}" ]] && grep -F -- "$GIT_HOME" "$lock" >/dev/null; then
    echo "    WARN $name: libpin.toml contains expanded git_home $GIT_HOME (clean filter did not run)" >&2
    echo "    pre-commit: kit/hooks/pre-commit-git-home-leak" >&2
    return 1
  fi
  return 0
}

cmd_check() {
  local name="$1" lock track host rc=0 kind pin_sha tag_sha
  echo "==> $name  check"
  lock="$(pin_path "$name")"
  [[ -f "$lock" ]] || { echo "FAIL $name: no libpin.toml" >&2; return 1; }
  local leak=0
  check_git_home_leak "$name" || leak=1
  rc=0
  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if pin_is_git "$lock"; then
    if [[ "$rc" -eq 0 ]]; then
      echo "    host $host"
      track="$(pin_get_opt "$lock" track_branch)" || exit 1
      if [[ -n "$track" ]]; then
        kind="$(lookup_track_kind "$host" "$track")" || return 1
        if [[ "$kind" == tag ]]; then
          resolve_pin_sha_for "$name" || return 1
          pin_sha="$(resolve_commit "$host" "$RESOLVED_SHA" host)" || return 1
          tag_sha="$(resolve_commit "$host" "refs/tags/$track" host)" || return 1
          if [[ "$tag_sha" != "$pin_sha" ]]; then
            echo "    FAIL: tag moved: track_branch $track now $tag_sha, pin is $pin_sha" >&2
            return 1
          fi
          echo "    tag $track still at pin"
        fi
      fi
    fi
    check_depends "$name" || return 1
  fi
  if [[ "$leak" -ne 0 ]]; then
    return 1
  fi
  echo "    OK check $name"
}

cmd_outdated() {
  local name="$1" lock src sp host rc=0 track kind tip pin_sha last url info
  if should_reenter; then
    echo "    [sandbox=lib $name]"
    reenter_self lib "$name" outdated
    return $?
  fi
  echo "==> $name  outdated"
  lock="$(pin_path "$name")"
  if ! pin_is_git "$lock"; then
    echo "    skip (not git)"
    return 0
  fi
  src="$(src_path "$name")"
  sp="$(status_path "$name")"
  resolve_pin_sha_for "$name" || return 1
  pin_sha="$RESOLVED_SHA"
  track="$(pin_get_opt "$lock" track_branch)" || exit 1
  host=""
  rc=0
  host="$(local_repo_for "$name")" || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if [[ "$rc" -eq 0 ]]; then
    pin_sha="$(resolve_commit "$host" "$pin_sha" host)" || return 1
    if [[ -n "$track" ]]; then
      kind="$(lookup_track_kind "$host" "$track")" || return 1
      if [[ "$kind" == tag ]]; then
        tip="$(resolve_commit "$host" "refs/tags/$track" host)" || return 1
      else
        tip="$(resolve_commit "$host" "refs/heads/$track" host)" || return 1
      fi
    else
      tip="$(git_host "$host" rev-parse HEAD)"
    fi
  elif [[ -n "$track" ]] && url="$(pin_remote_url "$name")"; then
    info="$(remote_ls_track "$url" "$track" "$name")" || return 1
    kind="${info%% *}"
    tip="${info#* }"
  else
    echo "    FAIL: cannot determine upstream (need host shortcut, or git_https/git_ssh + track_branch)" >&2
    return 1
  fi
  last=""
  if [[ -f "$sp" ]]; then
    last="$(status_get "$sp" last_upstream)"
  fi
  if [[ "$tip" != "$pin_sha" ]]; then
    if [[ -n "$last" && "$tip" != "$last" ]]; then
      echo "    upstream moved since last check ($last → $tip); pin still $pin_sha"
    elif [[ -n "$last" && "$tip" == "$last" ]]; then
      echo "    still behind with no new movement (pin $pin_sha, upstream $tip)"
    else
      echo "    behind upstream $tip (pin $pin_sha); no previous check recorded"
    fi
  else
    echo "    current with upstream $tip"
  fi
  local mode="" branch="" head=""
  if [[ -f "$sp" ]]; then
    mode="$(status_get "$sp" mode)"
    branch="$(status_get "$sp" branch)"
    head="$(status_get "$sp" head)"
  fi
  [[ -n "$mode" ]] || mode="?"
  write_status "$name" "$mode" "$branch" "$head" "last_upstream: $tip"$'\n'"last_upstream_at: $(date -Is)"
  echo "    recorded last_upstream $tip"
}

# --- test/debug printers (no pin work) ---
if [[ "$CMD" == "print-host-perm-suggestions" ]]; then
  [[ ${#NAMES[@]} -eq 0 ]] || { echo "fetch-deps: --print-host-perm-suggestions takes exactly 8 arguments" >&2; exit 2; }
  host_perm_suggestions "${PRINT_ARGS[@]}"
  exit 0
fi
if [[ "$CMD" == "print-owner-host-perm" ]]; then
  [[ ${#NAMES[@]} -eq 0 ]] || { echo "fetch-deps: --print-owner-host-perm takes exactly 3 arguments" >&2; exit 2; }
  report_owner_host_perm "${PRINT_ARGS[@]}"
  exit 0
fi

# --- default names ---
if [[ "$CMD" != "status" && "$CMD" != "upgrade" && ${#NAMES[@]} -eq 0 ]]; then
  for d in "$ROOT"/*/; do
    [[ -f "${d}libpin.toml" ]] || continue
    base="$(basename "$d")"
    [[ "$base" == "tests" ]] && continue
    def="$(pin_get_opt "${d}libpin.toml" default)" || exit 1
    [[ "$def" == "false" ]] && continue
    NAMES+=("$base")
  done
fi
if [[ "$CMD" == "upgrade" ]]; then
  [[ ${#NAMES[@]} -eq 1 ]] || { echo "upgrade needs exactly one NAME" >&2; exit 2; }
  [[ -n "$REF_UPGRADE" ]] || { echo "upgrade needs --ref" >&2; exit 2; }
fi
if [[ ${#NAMES[@]} -eq 0 && "$CMD" != "status" ]]; then
  echo "fetch-deps: no libraries with libpin.toml" >&2
  exit 2
fi
if [[ "$CMD" == "status" && ${#NAMES[@]} -eq 0 ]]; then
  for d in "$ROOT"/*/; do
    [[ -f "${d}libpin.toml" ]] && NAMES+=("$(basename "$d")")
  done
fi

run_pin() {
  local fn="$1" name="$2" rc=0
  set +e
  (
    set -euo pipefail
    "$fn" "$name"
  )
  rc=$?
  set -euo pipefail
  if [[ "$rc" -ne 0 ]]; then
    FAILED_NAMES+=("$name")
    echo "fetch-deps: FAIL $name (exit $rc)" >&2
  fi
}

echo "fetch-deps: cmd=$CMD GIT_HOME=$GIT_HOME version=$LIBPIN_VERSION"

case "$CMD" in
  status)
    for n in "${NAMES[@]}"; do cmd_status "$n"; done
    ;;
  ro)
    for n in "${NAMES[@]}"; do run_pin cmd_ro "$n"; done
    ;;
  rw)
    for n in "${NAMES[@]}"; do run_pin cmd_rw "$n"; done
    ;;
  refresh)
    for n in "${NAMES[@]}"; do run_pin cmd_refresh "$n"; done
    ;;
  build)
    if [[ "$RECORD" -eq 1 ]]; then _bm=record; else _bm=verify; fi
    for n in "${NAMES[@]}"; do
      set +e
      (
        set -euo pipefail
        cmd_build "$n" "$_bm"
      )
      rc=$?
      set -euo pipefail
      if [[ "$rc" -ne 0 ]]; then
        FAILED_NAMES+=("$n")
        echo "fetch-deps: FAIL $n (exit $rc)" >&2
      fi
    done
    ;;
  upgrade)
    run_pin cmd_upgrade "${NAMES[0]}"
    ;;
  check)
    for n in "${NAMES[@]}"; do run_pin cmd_check "$n"; done
    ;;
  outdated)
    for n in "${NAMES[@]}"; do run_pin cmd_outdated "$n"; done
    ;;
  *)
    echo "unknown command $CMD" >&2
    exit 2
    ;;
esac

if [[ ${#FAILED_NAMES[@]} -gt 0 ]]; then
  echo "fetch-deps done (failures=${#FAILED_NAMES[@]}): ${FAILED_NAMES[*]}" >&2
  exit 1
fi
echo "fetch-deps done (failures=0)."
exit 0
